{
  "name": "yairp",
  "version": "0.6.43",
  "private": true,
  "description": "Yet Another Idle RPG - a text-based idle RPG (fork of miktaew/yet-another-idle-rpg)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-site.js",
    "check": "node tests/run.mjs",
    "check:bundle": "node tests/bundle-loads.mjs",
    "check:save": "node tests/save.mjs",
    "test": "node tests/skills.mjs",
    "serve": "esbuild --servedir=. --serve=127.0.0.1:8080",
    "serve:site": "esbuild --servedir=_site --serve=127.0.0.1:8081"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
