# Line endings
# ----------------------------------------------------------------------------
# The index already stores every text file with LF (verified with
# `git ls-files --eol`: 50 files at i/lf), while Windows working copies check
# out as CRLF via core.autocrlf. Declaring it here makes that behaviour a
# property of the repository instead of a property of each contributor's local
# Git config, which is what silences the "LF will be replaced by CRLF"
# warnings for good. Because the index is already LF, this introduces no
# renormalization diff.
* text=auto

# Binary assets
# ----------------------------------------------------------------------------
# `binary` is shorthand for `-text -diff`: never convert line endings, never
# try to render a textual diff.
*.png binary
*.ico binary
*.ttf binary

# Generated build output
# ----------------------------------------------------------------------------
# dist/ is not tracked (see .gitignore), so the esbuild output needs no
# attributes here. package-lock.json is machine-written but must stay
# committed, so it keeps its diff and language-statistics exemption.
package-lock.json  -diff linguist-generated

# Vendored third-party code
# ----------------------------------------------------------------------------
# HackTimer is upstream vendored code (MIT, see its own LICENSE). Excluded from
# language stats; the minified files are single-line and not worth diffing.
resources/js/HackTimer/**       linguist-vendored
resources/js/HackTimer/*.min.js -text -diff
