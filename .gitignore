todo.txt
achievements.js

# Dependencies
/node_modules

# Build output. Both are throwaway and neither is committed: `npm run build`
# writes dist/bundle.js and then assembles _site/ from it, and the deploy
# workflow runs that build itself before publishing.
dist/
_site/

# Local-only tooling configs inherited from upstream. If a shared linter or
# dependency-graph config is ever added to the project, remove the matching
# line first - otherwise the config silently refuses to be committed.
.eslintrc.json
.dependency-cruiser.js
dependency-graph.svg

# Sample savegames dropped in the root for analysis. These are exported player
# saves - real character data - and must never be committed.
yet-another-idle-rpg*.txt

# Playwright MCP output. Page snapshots and console logs written into the repo
# root while driving the game in a browser to verify a change. Throwaway.
.playwright-mcp/

# Agent session config: the development loop's instructions, and whatever local
# settings a harness writes next to them. Kept local for a reason beyond taste -
# .loop.md is written in Turkish, and D-3 holds every tracked markdown file to a
# NAME.md / NAME.TR.md pair at a matching doc-version. Committing this directory
# would have check_docs_are_paired demand a .loop.TR.md and fail the quality gate
# the loop itself has to pass. If something in here should ever be shared, add
# that one file as an English-canonical pair rather than removing this line.
.claude/

# Logs
*.log
npm-debug.log*

# Editor / IDE. Remove the .vscode line if project-wide editor settings should
# be shared rather than kept local.
.vscode/
.idea/
*.swp
*~

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
